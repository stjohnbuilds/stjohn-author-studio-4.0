{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/context-check.sh" },
          { "type": "command", "command": "bash .claude/hooks/progress-trigger.sh" },
          { "type": "command", "command": "bash .claude/hooks/deep-check-trigger.sh" },
          { "type": "command", "command": "bash .claude/hooks/handover-trigger.sh" },
          { "type": "command", "command": "bash .claude/hooks/ui-check-trigger.sh" },
          { "type": "command", "command": "bash .claude/hooks/usability-check-trigger.sh" },
          { "type": "command", "command": "bash .claude/hooks/goodnight-trigger.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/git-backup.sh", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/file-tracker.sh" },
          { "type": "command", "command": "bash .claude/hooks/cross-mode-parity.sh", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/no-mess.sh" },
          { "type": "command", "command": "bash .claude/hooks/build-checker.sh", "timeout": 60 },
          { "type": "command", "command": "bash .claude/hooks/stop-no-self-cert.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
